/// The operational infrastructure API for **in-world controllers**: a device the embedder grants
/// this interface (`DeviceOptions::infra`), such as the `replicas` controller app, creates,
/// starts, stops, removes, sends commands to, lists, watches and reads the logs of sibling
/// devices while the world runs.
///
/// **Every mutation is a derived operator event.** A call never changes the world inside the
/// call: it validates, records what was asked (the resource shows it as its `target`), journals
/// an `infra-<verb>` event on the caller, and queues the change in the simulation's one event
/// queue at the caller's own position (the processing context of the call, like a frame
/// transmitted with zero latency; a graceful stop at `now + grace`). The change applies when the
/// world reaches that event, before anything it causes, so it is deterministic, recomputed on
/// replay (never recorded as an operator input), and a debugger can stop the world between the
/// request and its effect. Reads (`get`, `list`, `watch`, `logs`) are answered from the
/// world as it is at the call.
///
/// **No new authority.** The host serves this interface only to devices whose
/// `DeviceOptions::infra` is set, and refuses to instantiate any other component that imports
/// it. It reaches no host resource. A controller may change only the devices it created (`owner`); it
/// reads the network's own devices and the ones it created, not other controllers' (its view of
/// the table). A device spec it applies can grant nothing (no `infra`).
///
/// Specs are CBOR (deterministic encoding): a device as the embedder describes it, without its
/// name, plus its cables:
///
/// ```text
/// { "component": "node:http-server",          ; a catalog name
///   "config":    { "mac": "02:..", "app.http-server.listen": "0.0.0.0:80", ... },
///                                               ; text values; nested maps flatten with "."
///   ? "stdio":   "journal",                     ; stdout/stderr lines into the journal
///   ? "fuel_per_instant": uint,
///   ? "wire":    [ { "port": uint, "to": "sw:3" / "sw", ? "latency": uint (ns), ? "mtu": uint } ] }
///                                               ; "to" without a port: the first free port
///                                               ; of that device when the change applies
/// ```
///
/// No other system's types cross this interface: a controller translates whatever it speaks
/// into these specs.
///
/// Versions: 0.1.1 added `devices.control`. A component built against 0.1.0 still links, since
/// an addition keeps the `0.1` line compatible.
package wasmnet:infra@0.1.1;

interface types {
    /// Virtual time in nanoseconds since the simulation started.
    type instant = u64;

    /// A resource version: the ordinal of the last change that touched a device, among the
    /// changes in the caller's view of the world's device table (1 for the first change; 0:
    /// nothing has changed yet). The list's `rv` is the latest change. Monotonic within a run,
    /// the same on every replay, and the same when the world is split over sites.
    type rv = u64;

    /// Labels: `(key, value)` pairs, sorted by key, keys unique.
    type labels = list<tuple<string, string>>;

    /// What a device is doing.
    enum phase {
        /// Asked for (by `apply`) and not created yet.
        pending,
        running,
        /// Stopped (by `stop` or an operator): no store, its links down, its name kept.
        stopped,
        /// It trapped: stopped by its own fault (its links down, `message` the trap). Only devices
        /// a controller created crash alone; a trap anywhere else fails the whole run. `start`
        /// runs it again.
        crashed,
        /// Removed: unwired, its name free. Only seen in a `deleted` change.
        removed,
        /// The last request could not be applied (`message` says why): apply again or remove.
        failed,
    }

    /// One device, as the world has it.
    record device {
        name: string,
        /// Stable for the device's life (an `apply` that recreated it keeps it): the digest of
        /// the event that created it, so reruns and forks with the same history agree.
        uid: string,
        /// 1 at creation, +1 per spec change (an `apply` that recreated it).
        generation: u64,
        /// The change that last touched it.
        rv: rv,
        labels: labels,
        /// The controller that created it; `none`: the network's description or an operator.
        owner: option<string>,
        /// Its spec (CBOR, see the package docs): as applied, or as asked while `pending`.
        spec: list<u8>,
        phase: phase,
        /// Where the requests still queued for it lead (`running`, `stopped`, `removed`);
        /// `none` when nothing is queued.
        target: option<phase>,
        /// When it entered its phase.
        since: instant,
        /// Its apps that returned, by name: `ok` or `error` (a composed node's `app-exit`). Only
        /// devices a controller created list them; the network's own devices list none.
        apps: list<tuple<string, string>>,
        /// Why the last request about it failed, if it did.
        message: option<string>,
    }

    /// How a change touched a device.
    enum change-kind {
        added,
        modified,
        deleted,
    }

    /// One watch event: the device as of that change (`device.rv`).
    record change {
        kind: change-kind,
        device: device,
    }

    /// One line a device wrote (the device needs `DeviceOptions::journal_stdio`).
    record log-line {
        at: instant,
        /// `stdout` or `stderr`.
        %stream: string,
        line: string,
    }

    /// What `apply` did.
    record applied {
        device: device,
        /// `false`: the device already had this spec and labels (nothing was queued).
        changed: bool,
    }

    variant error {
        /// The name is taken by a device with another owner, or a request id was reused with
        /// other arguments.
        conflict(string),
        /// No such device.
        not-found(string),
        /// A malformed spec, name, selector, stream or command, or a command for a device that
        /// is not running.
        invalid(string),
        /// Not this caller's to change (another owner, the caller itself), or a spec that
        /// would grant authority (`infra`), or a name outside the caller's name prefix; also every
        /// call from a device that was not granted this interface.
        denied(string),
    }
}

/// The devices of the caller's world. Every function is **sync and never yields**; the host
/// stamps everything with virtual time. Arguments and results are owned by the caller (lists
/// are copied across the boundary).
///
/// Mutations (`apply`, `start`, `stop`, `remove`, `control`) take an optional `request-id`: the
/// host keeps the last 256 answers per caller, so a retry with the same id and arguments is
/// answered from the record and never applied twice; the same id with other arguments is a
/// `conflict`. Every mutation but `control` is idempotent by name besides: asking for what is
/// already true (or already queued) queues nothing.
interface devices {
    use types.{instant, rv, labels, phase, device, change, log-line, applied, error};

    /// Creates the device `name` from `spec` (CBOR) with `labels`, or updates it: a device with
    /// another spec is recreated (removed and added again with its new cables, in one change:
    /// same uid, generation + 1); one with other labels only gets the labels at once. A new
    /// device starts running when the change applies (there is no separate start: a later
    /// `start` is a no-op). Returns the device as asked for (`pending`, or with its `target`).
    /// Fails with `conflict` if `name` belongs to another owner (or to the network's
    /// description), `invalid` for a bad spec, `denied` for a spec that grants authority.
    apply: func(request-id: option<string>, name: string, labels: labels, spec: list<u8>) -> result<applied, error>;

    /// Starts a stopped or crashed device again (a fresh instance of its component and config; the links
    /// its stop took down come back up). A running or pending device: a no-op.
    start: func(request-id: option<string>, name: string) -> result<device, error>;

    /// Stops a running device after `grace-ns` of virtual time (0: at once): it keeps running
    /// for the grace period, then its store is dropped and its links go down (the far ends see
    /// the carrier drop). Its name, spec and cables stay. A stopped device: a no-op.
    stop: func(request-id: option<string>, name: string, grace-ns: u64) -> result<device, error>;

    /// Removes a device (stopped if running, unwired, its name free), after any change still
    /// queued for it (so `stop` with a grace period, then `remove`, removes it after the grace
    /// period). `false`: there was no such device (a successful no-op).
    remove: func(request-id: option<string>, name: string) -> result<bool, error>;

    /// Sends `command` with `argument` to the `wasmnet:control/commands` export of a device this
    /// caller created (a router's `route-add` with `10.0.3.0/24 via 10.0.2.2`), which changes it
    /// in place: its frames in flight, its state, its links and their captures stay, as they
    /// would not if it were recreated.
    ///
    /// - Like every mutation it only records and queues: the command runs in the device when the
    ///   derived event applies, at `now` and after any request still queued for the device (so an
    ///   `apply` followed by a `control` reaches the new device), and the device is polled at that
    ///   instant after it. Returns the device as asked for (`target`: `running`).
    /// - The device's answer is not returned. A refusal (the device's `err`, or a device that
    ///   stopped meanwhile or takes no commands) is journalled on the caller as
    ///   `infra-failed {verb: control, name, message}` at the instant it is known, and shown as
    ///   the device's `message`; what a command did is in the device's own journal.
    /// - Idempotent by request id only: without one, every call sends the command again, so a
    ///   device's commands should be idempotent themselves (the router's are).
    /// - Fails with `not-found` for no such device; `denied` for a device another owner or the
    ///   network's description has, or the caller itself; `invalid` for a command that is not
    ///   1 to 63 lowercase letters, digits and `-` starting with a letter, an argument over
    ///   64 KiB, or a device that is not running or about to run.
    control: func(request-id: option<string>, name: string, command: string, argument: string) -> result<device, error>;

    /// One device of the caller's view (including one still `pending`).
    get: func(name: string) -> result<device, error>;

    /// Every device of the caller's view whose labels include all of `selector`'s pairs (an
    /// empty selector: every one), sorted by name, with the latest `rv` (pass it to `watch` to see what changes
    /// next).
    %list: func(selector: labels) -> tuple<rv, list<device>>;

    /// The changes after `since` to devices matching `selector`, in world order, at most `max`
    /// of them, and the `rv` to resume from (the last change returned, or the latest if fewer
    /// than `max` matched). A pollable feed: a controller calls it on its period; nothing
    /// blocks. Pending requests are not changes (they show in `list` and `get`).
    watch: func(selector: labels, since: rv, max: u32) -> tuple<rv, list<change>>;

    /// The last `tail` lines (0: all) the device wrote to `stream` (`stdout` or `stderr`) at or
    /// after `since`, oldest first, of a device the caller created (`denied` for the network's own
    /// devices). Needs the device's `DeviceOptions::journal_stdio` (otherwise none).
    logs: func(name: string, %stream: string, since: instant, tail: u32) -> result<list<log-line>, error>;
}

/// An in-world controller's capability: what the embedder grants a device it marks as a
/// controller.
world controller {
    import devices;
}
