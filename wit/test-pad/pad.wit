package wasmnet-test:pad@0.1.0;

/// A test fixture's portable interface (`crates/wasmnet-pad`): notes a device keeps, served by
/// a network extension on every backend. Every function is synchronous, never yields and takes
/// no virtual time; it is served from the calling device's own notes. The caller owns every
/// list it gets back.
interface notes {
    /// A number of bytes: a note's size, or an offset into one.
    type count = u64;

    /// How many bytes a read asks for.
    type length = u32;

    /// Why an append did not happen.
    variant error {
        /// The device's notes would pass their bound: the bytes they hold now.
        full(count),
        /// The note was discarded (its device's notes were cleared since it was opened).
        gone,
    }

    /// A note's state.
    enum state { empty, written }

    /// What a note holds.
    record info {
        name: string,
        size: count,
        appends: u32,
        state: state,
    }

    /// One named note of the device: created empty, or found again with `find`.
    resource note {
        /// The note `name`, created empty if the device has none of that name.
        constructor(name: string);
        /// Appends `bytes`; answers the note's new size. The extension may fault the device
        /// here instead (a fault its options arm).
        append: func(bytes: list<u8>) -> result<count, error>;
        /// Up to `len` bytes from `offset` (fewer at the end, none past it).
        read: func(offset: count, len: length) -> list<u8>;
        info: func() -> info;
        /// The note `name`, if the device has one.
        find: static func(name: string) -> option<note>;
    }

    /// The device's notes, by name, ascending.
    names: func() -> list<string>;

    /// How many notes the device has, and the bytes they hold.
    totals: func() -> tuple<u32, count>;
}

/// What a device that keeps notes shows its network, called by name from outside (a portable
/// export): between runs, as an operator event or from inside a run. Every function runs at the
/// call's instant, takes no virtual time and never yields.
interface inspect {
    use notes.{count, length};

    /// Appends `bytes` to the note `name` (created if missing), as the device would: the note's
    /// new size, or why not.
    write: func(name: string, bytes: list<u8>) -> result<count, string>;
    /// Up to `len` bytes of the note `name` from `offset`; none if it has no such note.
    read: func(name: string, offset: count, len: length) -> list<u8>;
    /// The size of the note `name`, if the device has one.
    size: func(name: string) -> option<count>;
}

/// What a device that keeps notes imports.
world user {
    import notes;
}

/// A device that keeps notes and shows them.
world keeper {
    import notes;
    export inspect;
}
