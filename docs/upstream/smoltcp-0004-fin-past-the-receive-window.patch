+    #[test]
+    fn test_established_receive_fin_past_right_window_edge() {
+        let mut s = socket_established_with_buffer_sizes(64, 6);
+
+        // Eight octets and a FIN against a window of six: the segment is cut at the window's
+        // right edge, so its FIN lies beyond the window too and must not be accepted
+        // (RFC 9293 3.10.7.4). Accepting it would end the stream without "gh".
+        send!(
+            s,
+            TcpRepr {
+                seq_number: REMOTE_SEQ + 1,
+                ack_number: Some(LOCAL_SEQ + 1),
+                control: TcpControl::Fin,
+                payload: &b"abcdefgh"[..],
+                ..SEND_TEMPL
+            }
+        );
+        assert_eq!(s.state, State::Established);
+        recv!(
+            s,
+            [TcpRepr {
+                seq_number: LOCAL_SEQ + 1,
+                ack_number: Some(REMOTE_SEQ + 1 + 6),
+                window_len: 0,
+                ..RECV_TEMPL
+            }]
+        );
+
+        s.recv(|data| {
+            assert_eq!(data, b"abcdef");
+            (6, ())
+        })
+        .unwrap();
+
+        // The app read: the window opens again.
+        recv!(
+            s,
+            [TcpRepr {
+                seq_number: LOCAL_SEQ + 1,
+                ack_number: Some(REMOTE_SEQ + 1 + 6),
+                window_len: 6,
+                ..RECV_TEMPL
+            }]
+        );
+
+        // The peer sends the rest again, with its FIN: now it fits.
+        send!(
+            s,
+            TcpRepr {
+                seq_number: REMOTE_SEQ + 1 + 6,
+                ack_number: Some(LOCAL_SEQ + 1),
+                control: TcpControl::Fin,
+                payload: &b"gh"[..],
+                ..SEND_TEMPL
+            }
+        );
+        assert_eq!(s.state, State::CloseWait);
+        s.recv(|data| {
+            assert_eq!(data, b"gh");
+            (2, ())
+        })
+        .unwrap();
+    }
+
