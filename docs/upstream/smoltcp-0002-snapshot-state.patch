+    /// wasmnet patch (feature `snapshot`): adds `socket` at slot `index`, so a
+    /// restored set polls its sockets in the saved order (the slot order). `None` if the slot
+    /// is taken (or the storage cannot grow).
+    #[cfg(feature = "snapshot")]
+    pub fn add_at<T: AnySocket<'a>>(&mut self, index: usize, socket: T) -> Option<SocketHandle> {
+        if let ManagedSlice::Owned(sockets) = &mut self.sockets {
+            while sockets.len() <= index {
+                sockets.push(SocketStorage { inner: None });
+            }
+        }
+        let slot = self.sockets.get_mut(index)?;
+        if slot.inner.is_some() {
+            return None;
+        }
+        let handle = SocketHandle(index);
+        let mut meta = Meta::default();
+        meta.handle = handle;
+        *slot = SocketStorage {
+            inner: Some(Item {
+                meta,
+                socket: socket.upcast(),
+            }),
+        };
+        Some(handle)
+    }
