+    #[test]
+    fn test_hush_is_bounded() {
+        let mut cache = Cache::new();
+        let addr = |i: usize| -> IpAddress {
+            #[cfg(feature = "proto-ipv6")]
+            return IpAddress::v6(0xfdaa, 0, 0, 0, 0, 0, 0, i as u16 + 1);
+            #[cfg(not(feature = "proto-ipv6"))]
+            return IpAddress::v4(10, 0, 0, i as u8 + 1);
+        };
+        let full = IFACE_NEIGHBOR_CACHE_COUNT;
+        // Requests for `full` different addresses within one silent period all go out ...
+        for i in 0..full {
+            let t = Instant::from_millis(i as i64);
+            assert_eq!(cache.lookup(&addr(i), t), Answer::NotFound);
+            cache.limit_rate(addr(i), t);
+        }
+        // ... but not one more: the request rate stays bounded.
+        let t = Instant::from_millis(full as i64);
+        assert_eq!(cache.lookup(&addr(full), t), Answer::RateLimited);
+        // Once the first silence ended, its slot is reused for a new address.
+        let t = Instant::from_millis(0) + Cache::SILENT_TIME;
+        assert_eq!(cache.lookup(&addr(full), t), Answer::NotFound);
+        cache.limit_rate(addr(full), t);
+        assert_eq!(cache.lookup(&addr(full), t), Answer::RateLimited);
+        // Every slot is silent again, so the evicted address waits for the next free one.
+        assert_eq!(cache.lookup(&addr(0), t), Answer::RateLimited);
+        let t = t + Duration::from_millis(1);
+        assert_eq!(cache.lookup(&addr(1), t), Answer::NotFound);
+        assert_eq!(cache.lookup(&addr(0), t), Answer::NotFound);
+        assert_eq!(cache.lookup(&addr(2), t), Answer::RateLimited);
+    }
