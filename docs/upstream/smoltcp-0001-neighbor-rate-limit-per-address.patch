+#[rstest]
+#[case(Medium::Ethernet)]
+#[cfg(feature = "medium-ethernet")]
+fn test_arp_requests_are_rate_limited_per_address(#[case] medium: Medium) {
+    let (mut iface, _sockets, _device) = setup(medium);
+    let a = IpAddress::Ipv4(Ipv4Address::new(192, 168, 1, 2));
+    let b = IpAddress::Ipv4(Ipv4Address::new(192, 168, 1, 3));
+
+    // A request for `a` goes out ...
+    assert_eq!(
+        iface
+            .inner
+            .lookup_hardware_addr(MockTxToken, &a, &mut iface.fragmenter),
+        Err(DispatchError::NeighborPending)
+    );
+    let now = iface.inner.now;
+    assert_eq!(
+        iface.inner.neighbor_cache.lookup(&a, now),
+        NeighborAnswer::RateLimited
+    );
+    // ... and does not hold back the request for `b` at the same instant.
+    assert_eq!(
+        iface.inner.neighbor_cache.lookup(&b, now),
+        NeighborAnswer::NotFound
+    );
+    assert_eq!(
+        iface
+            .inner
+            .lookup_hardware_addr(MockTxToken, &b, &mut iface.fragmenter),
+        Err(DispatchError::NeighborPending)
+    );
+    assert_eq!(
+        iface.inner.neighbor_cache.lookup(&b, now),
+        NeighborAnswer::RateLimited
+    );
+}
+
 #[rstest]
