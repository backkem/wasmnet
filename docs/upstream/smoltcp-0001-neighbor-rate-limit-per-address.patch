+    /// A discovery request for `protocol_addr` was sent at `timestamp`: silence that address
+    /// for [`Cache::SILENT_TIME`].
+    pub(crate) fn limit_rate(&mut self, protocol_addr: IpAddress, timestamp: Instant) {
+        let until = timestamp + Self::SILENT_TIME;
+        if let Some(slot) = self.silent_until.get_mut(&protocol_addr) {
+            *slot = until;
+            return;
+        }
+        if self.silent_until.is_full() {
+            // Reuse the slot that went quiet first (`lookup` only lets a new address through
+            // when at least one slot has expired).
+            let oldest = *self
+                .silent_until
+                .iter()
+                .min_by_key(|(_, until)| **until)
+                .expect("full map is not empty")
+                .0;
+            self.silent_until.remove(&oldest);
+        }
+        let _ = self.silent_until.insert(protocol_addr, until);
     }
 
