+    #[test]
+    fn test_rtt_estimator_bounds() {
+        // The defaults: RFC 6298's 1 s minimum.
+        let mut r = RttEstimator::default();
+        r.sample(10);
+        assert_eq!(r.retransmission_timeout(), Duration::from_millis(1000));
+
+        // A lower minimum: 10 + max(5, 4 * 5) = 30, raised to 200.
+        let mut r = RttEstimator {
+            min_rto: 200,
+            ..RttEstimator::default()
+        };
+        r.sample(10);
+        assert_eq!(r.retransmission_timeout(), Duration::from_millis(200));
+        // A steady 300 ms path: RTTVAR decays to 3 ms (where rounding up holds it) and the
+        // timeout falls to SRTT + 12 ms.
+        for _ in 0..100 {
+            r.sample(300);
+        }
+        assert_eq!(r.retransmission_timeout(), Duration::from_millis(312));
+
+        // With Linux's margin the timeout stays at least SRTT + 200 ms.
+        let mut r = RttEstimator {
+            min_rto: 200,
+            min_margin: 200,
+            ..RttEstimator::default()
+        };
+        r.sample(10);
+        assert_eq!(r.retransmission_timeout(), Duration::from_millis(210));
+        for _ in 0..100 {
+            r.sample(300);
+        }
+        assert_eq!(r.retransmission_timeout(), Duration::from_millis(500));
+
+        // The bounds survive a reset, the measurement does not.
+        let r = r.reset();
+        assert_eq!((r.min_rto, r.min_margin), (200, 200));
+        assert!(!r.have_measurement);
+        assert_eq!(r.retransmission_timeout(), Duration::from_millis(1000));
+    }
+
+    #[test]
+    fn test_set_rto_min_and_margin() {
+        let mut s = socket_established();
+        assert_eq!(s.rto_min(), Duration::from_millis(1000));
+        assert_eq!(s.rto_min_margin(), Duration::from_millis(5));
+        s.set_rto_min(Duration::from_millis(200));
+        s.set_rto_min_margin(Duration::from_secs(120));
+        assert_eq!(s.rto_min(), Duration::from_millis(200));
+        // Above the largest timeout: 60 s.
+        assert_eq!(s.rto_min_margin(), Duration::from_secs(60));
+        s.set_rto_min_margin(Duration::from_millis(200));
+        s.reset();
+        assert_eq!(s.rto_min(), Duration::from_millis(200));
+        assert_eq!(s.rto_min_margin(), Duration::from_millis(200));
+    }
