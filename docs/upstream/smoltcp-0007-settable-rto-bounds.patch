+    /// Set the least retransmission timeout once the round-trip time is measured.
+    ///
+    /// By default it is RFC 6298's 1 second (2.4); Linux uses 200 ms (`TCP_RTO_MIN`). The
+    /// timeout before the first measurement is 1 second whatever this is (RFC 6298 (2.1)),
+    /// and backing off doubles the timeout in force, up to 60 seconds. A value above 60
+    /// seconds counts as 60 seconds; the timeout counts in whole milliseconds.
+    ///
+    /// The new bound applies from the next round-trip sample on. A minimum below the default
+    /// usually wants a larger [minimum margin](#method.set_rto_min_margin) as well, so that
+    /// a peer's delayed acknowledgement does not trip the timeout on a long, steady path.
+    pub fn set_rto_min(&mut self, duration: Duration) {
+        self.rtte.min_rto = Self::rto_millis(duration);
+    }
+
+    /// Return the least retransmission timeout once the round-trip time is measured (see
+    /// [`set_rto_min`](#method.set_rto_min)).
+    pub fn rto_min(&self) -> Duration {
+        Duration::from_millis(self.rtte.min_rto as _)
+    }
+
+    /// Set the least margin of the retransmission timeout over the smoothed round-trip time.
+    ///
+    /// The timeout is `SRTT + max(G, K * RTTVAR)` (RFC 6298 (2.2), (2.3)), and at least the
+    /// [minimum timeout](#method.set_rto_min); this sets `G`, 5 ms by default. On a steady
+    /// path `RTTVAR` decays towards zero and the timeout falls towards `SRTT + G`, so that a
+    /// segment acknowledged a little later than the ones before it (by a delayed
+    /// acknowledgement, say) is retransmitted although it arrived. Linux keeps this margin
+    /// at its minimum timeout, 200 ms, the longest it delays an acknowledgement: its timeout
+    /// is at least `SRTT + 200 ms`. A value above 60 seconds counts as 60 seconds; the margin
+    /// counts in whole milliseconds.
+    ///
+    /// The new margin applies from the next round-trip sample on.
+    pub fn set_rto_min_margin(&mut self, duration: Duration) {
+        self.rtte.min_margin = Self::rto_millis(duration);
+    }
+
+    /// Return the least margin of the retransmission timeout over the smoothed round-trip
+    /// time (see [`set_rto_min_margin`](#method.set_rto_min_margin)).
+    pub fn rto_min_margin(&self) -> Duration {
+        Duration::from_millis(self.rtte.min_margin as _)
+    }
+
+    fn rto_millis(duration: Duration) -> u32 {
+        duration.total_millis().min(RTTE_MAX_RTO as u64) as u32
+    }
