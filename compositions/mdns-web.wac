// node-mdns-web = the netstack + the http-server and mdns-responder apps: a web
// server that claims `<hostname>.local` on its link.
//
// One netstack serves both apps' `wasi:sockets` imports; the responder also uses the netstack's
// `wasmnet:sockets-ext/{multicast,interfaces}` (join 224.0.0.251 / ff02::fb, hop limit 255, its
// own addresses).
package wasmnet:node-mdns-web;

let net = new wasmnet:netstack { ... };

let server = new app:http-server {
    "wasi:sockets/types@0.3.0": net["wasi:sockets/types@0.3.0"],
    "wasmnet:sockets-ext/tcp@0.1.0": net["wasmnet:sockets-ext/tcp@0.1.0"],
    ...
};

let mdns = new app:mdns-responder {
    "wasi:sockets/types@0.3.0": net["wasi:sockets/types@0.3.0"],
    "wasmnet:sockets-ext/multicast@0.1.0": net["wasmnet:sockets-ext/multicast@0.1.0"],
    "wasmnet:sockets-ext/interfaces@0.1.0": net["wasmnet:sockets-ext/interfaces@0.1.0"],
    ...
};

export net["wasmnet:link/device@0.1.0"];
export net["wasmnet:link/lifecycle@0.1.0"];
export net["wasmnet:link/counters@0.1.0"];
export server["wasi:cli/run@0.3.0"] as "app-http-server";
export mdns["wasi:cli/run@0.3.0"] as "app-mdns-responder";
